        "apps": [
          { "kind": "terminal" },
          {
            "kind": "dns-server",
            "records": [
              { "type": "A", "name": "web.local", "value": "192.168.1.20" },
              { "type": "CNAME", "name": "www.local", "value": "web.local" }
            ]
          }
        ],
        "interfaces": [
          { "id": "if_dns", "name": "eth0", "mac": "02:00:00:01:00:03", "ip": "192.168.1.53", "prefix": 24 }
