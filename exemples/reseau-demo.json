        "interfaces": [
          { "id": "if_pc1", "name": "eth0", "mac": "02:00:00:01:00:01" }
        ]
      },
      {
        "id": "d_web",
        "kind": "pc",
        "name": "WEB",
        "x": 96,
        "y": 240,
        "gateway": "192.168.1.1",
        "apps": [
          { "kind": "terminal" },
          {
            "kind": "web-server",
            "page": "<h1>Bienvenue sur Networx</h1><p>Cette page est servie par le serveur <strong>web.local</strong> (192.168.1.20).</p><p>Essayez aussi l'alias <strong>www.local</strong> depuis un navigateur.</p>"
          }
        ],
        "interfaces": [
          { "id": "if_web", "name": "eth0", "mac": "02:00:00:01:00:02", "ip": "192.168.1.20", "prefix": 24 }
        ]
      },
      {
        "id": "d_dns",
        "kind": "pc",
        "name": "DNS1",
